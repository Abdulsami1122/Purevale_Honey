// Prisma schema — Purevale Honey backend
// Datasource URL and secrets come from environment variables only (see .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  admin
}

enum OrderStatus {
  pending
  paid
  shipped
  delivered
  cancelled
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(customer)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart                Cart?
  orders              Order[]
  reviews             Review[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
}

// Opaque refresh tokens are stored hashed so a logout / breach can revoke them.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Single-use, time-limited password reset tokens (customer self-service).
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  // percentage off, 0 = no discount
  discountPercent Int   @default(0)
  // admin-set display rating + review count (independent of real Review rows)
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  // weight / size variants, e.g. [{ "label": "500g", "price": 1200 }]
  variants    Json     @default("[]")
  stock       Int      @default(0)
  images      String[] @default([])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([categoryId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   String  @default("")
  quantity  Int     @default(1)

  @@unique([cartId, productId, variant])
  @@index([productId])
}

model Order {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  items        OrderItem[]
  status       OrderStatus @default(pending)
  subtotal     Decimal     @db.Decimal(10, 2)
  discount     Decimal     @default(0) @db.Decimal(10, 2)
  shippingCost Decimal     @default(0) @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)

  shippingName    String
  shippingPhone   String
  shippingAddress String
  shippingCity    String
  shippingCountry String
  couponCode      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  variant   String   @default("")
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int

  @@index([orderId])
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
}

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  discountPercent Int
  expiresAt       DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
}

// Single-row key/value store for editable site content (announcement bar,
// hero, nav categories, story image, contact + socials). One row, key = "site".
model SiteSetting {
  key       String   @id
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

enum SubmissionType {
  contact
  export
}

model Submission {
  id        String         @id @default(uuid())
  type      SubmissionType
  name      String
  email     String
  phone     String?
  message   String?
  // export-inquiry-specific
  company     String?
  destination String?
  product     String?
  createdAt DateTime @default(now())

  @@index([type])
}
