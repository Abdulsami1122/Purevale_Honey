# ------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit .env.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/purevale_honey?schema=public"

# --- Auth secrets ---
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_hex_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- CORS ---
# Comma-separated list of allowed browser origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173
# Leave blank for localhost; set to your apex domain in production
COOKIE_DOMAIN=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Cloudinary (optional) — media uploads are disabled if any are blank ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------
# SEED ONLY — used once by `npm run seed:admin`, then DELETE ADMIN_PASSWORD.
# These are NOT read by the running server.
# ------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_NAME=Administrator
